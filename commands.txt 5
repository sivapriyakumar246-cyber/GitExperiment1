REM     branches: ["main"]
REM   pull_request:
REM     branches: ["main"]
REM jobs:
REM   build:
REM     runs-on: ubuntu-latest
REM     steps:
REM       - name: Checkout repository
REM         uses: actions/checkout@v4
REM       - name: Display a message
REM         run: echo "Hello, GitHub Actions!"

REM Step 6: Add the workflow file to Git
git add .github\workflows\main.yml

REM Step 7: Commit the workflow
git commit -m "Add basic GitHub Actions workflow"

REM Step 8: Push the workflow to GitHub
git push origin main

REM Step 9: Open GitHub Actions to check the workflow run
start https://github.com/sivapriyakumar246-cyber/GitExperiment1/actions
